#!/bin/sh

# PROVIDE: bsd44
# REQUIRE: LOGIN NETWORKING
# KEYWORD: shutdown

. /etc/rc.subr

name="bsd44"
rcvar="bsd44_enable"

load_rc_config "$name"

: ${bsd44_enable:="NO"}
: ${bsd44_dir:="%%APPDIR%%"}
: ${bsd44_user:="www"}
: ${bsd44_bind:="127.0.0.1"}
: ${bsd44_port:="9292"}
: ${bsd44_workers:="1"}
: ${bsd44_env:="production"}
: ${bsd44_bundle:="%%PREFIX%%/bin/bundle"}
: ${bsd44_path:="%%PREFIX%%/bin:/sbin:/bin:/usr/sbin:/usr/bin"}
: ${bsd44_logfile:="/var/log/bsd44.log"}
: ${bsd44_db_dir:="/var/db/bsd44"}
: ${bsd44_db_password:=""}
: ${bsd44_github_pat:=""}
: ${bsd44_deepseek_key:=""}
: ${bsd44_session_secret:=""}

# Falcon host runs a supervisor (the pidfile process) that owns the
# listener and manages forked workers. SIGHUP triggers a blue-green
# restart: fresh workers boot, then old ones are drained gracefully.
pidfile="/var/run/${name}.pid"

start_cmd="${name}_start"
stop_cmd="${name}_stop"
status_cmd="${name}_status"
restart_cmd="${name}_restart"

bsd44_start()
{
	if [ -f "$pidfile" ]; then
		echo "${name} is already running."
		return 1
	fi

	if [ ! -d "$bsd44_dir" ]; then
		warn "${bsd44_dir} does not exist"
		return 1
	fi

	echo "Starting ${name}."
	cd "$bsd44_dir" || return 1
	export BUNDLE_GEMFILE="${bsd44_dir}/Gemfile"
	export RACK_ENV="$bsd44_env"
	export PATH="$bsd44_path"
	export BSD44_BIND="$bsd44_bind"
	export BSD44_PORT="$bsd44_port"
	export BSD44_WORKERS="$bsd44_workers"
	[ -n "$bsd44_db_password" ] && export BSD44_DB_PASSWORD="$bsd44_db_password"
	[ -n "$bsd44_github_pat" ] && export GITHUB_BSD44_PAT="$bsd44_github_pat"
	[ -n "$bsd44_deepseek_key" ] && export DEEPSEEK_API_KEY="$bsd44_deepseek_key"
	[ -n "$bsd44_session_secret" ] && export SESSION_SECRET="$bsd44_session_secret"
	# Apply pending migrations against the PostgreSQL database, then start
	# the service. (PostgreSQL needs no local data dir or ownership steps.)
	"$bsd44_bundle" exec rake db:migrate || return 1
	/usr/sbin/daemon -f -p "$pidfile" -t "$name" -u "$bsd44_user" -o "$bsd44_logfile" \
		"$bsd44_bundle" exec falcon host
}

bsd44_stop()
{
	if [ ! -f "$pidfile" ]; then
		echo "${name} is not running."
		return 1
	fi

	echo "Stopping ${name}."
	kill "$(cat "$pidfile")"
	rm -f "$pidfile"
}

# Override rc.d's built-in `restart` (which is stop-then-start) with a
# graceful Falcon blue-green restart. Sending SIGHUP makes Falcon's
# controller fork fresh workers from the newly deployed code, wait for
# them to become ready, then gracefully drain the old ones — the shared
# listener stays bound the whole time, so there is no 502 gap. If the
# service isn't running, fall back to a plain start.
bsd44_restart()
{
	if [ ! -f "$pidfile" ]; then
		echo "Starting ${name}."
		bsd44_start
		return $?
	fi

	echo "Reloading ${name}."
	kill -HUP "$(cat "$pidfile")"
}

bsd44_status()
{
	if [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
		echo "${name} is running as pid $(cat "$pidfile")."
	else
		echo "${name} is not running."
		return 1
	fi
}

run_rc_command "$1"