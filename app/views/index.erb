<main class="home-showcase">
  <a class="home-logo" href="/" aria-label="44bsd home">
    <%= svg!("44bsd-workmark.svg") %>
  </a>

  <section class="home-console" id="home-console">
    <div class="console-output" id="console-output" aria-live="polite">
      <div class="console-status" id="console-status"></div>
      <div class="console-answer" id="console-answer">
        <%= render "partials/greeting" %>
      </div>
      <template id="console-answer-template">
        <%= render "partials/greeting" %>
      </template>
    </div>
    <form class="console-form" id="console-form" autocomplete="off">
      <span class="console-prompt">&gt;</span>
      <input disabled class="console-input" type="text" placeholder="Almost ready">
      <button class="console-expand" type="button" title="Expand chat" aria-label="Expand chat" aria-expanded="false">
        <svg class="icon-expand" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 3 21 3 21 9"></polyline><polyline points="9 21 3 21 3 15"></polyline><line x1="21" y1="3" x2="14" y2="10"></line><line x1="3" y1="21" x2="10" y2="14"></line></svg>
        <svg class="icon-collapse" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="4 14 10 14 10 20"></polyline><polyline points="20 10 14 10 14 4"></polyline><line x1="14" y1="10" x2="21" y2="3"></line><line x1="3" y1="21" x2="10" y2="14"></line></svg>
      </button>
      <button class="console-reset" type="button" title="Reset conversation" aria-label="Reset conversation">
        <svg class="console-reset-icon" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M11 1.75V3h2.25a.75.75 0 0 1 0 1.5H2.75a.75.75 0 0 1 0-1.5H5V1.75C5 .784 5.784 0 6.75 0h2.5C10.216 0 11 .784 11 1.75ZM4.496 6.675l.66 6.6a.25.25 0 0 0 .249.225h5.19a.25.25 0 0 0 .249-.225l.66-6.6a.75.75 0 0 1 1.492.149l-.66 6.6A1.748 1.748 0 0 1 10.595 15h-5.19a1.75 1.75 0 0 1-1.741-1.575l-.66-6.6a.75.75 0 1 1 1.492-.15ZM6.5 1.75V3h3V1.75a.25.25 0 0 0-.25-.25h-2.5a.25.25 0 0 0-.25.25Z"/></svg>
      </button>
    </form>
    <p class="console-note">powered by <a target="_blank" href="https://freebsd.org">FreeBSD</a></p>
  </section>

  <section class="home-contact">
    <h2 class="home-section-title">About</h2>
    <p>
      4.4bsd.dev is powered by FreeBSD 15.1-STABLE.
      <br>
      This service can provide answers by spawning man(1), apropos(1), and pkg-search(8),
      and it has access to the FreeBSD source tree (aka <code>/usr/src/</code>). It is equipped
      with tools that are efficient at querying the source tree. It is also possible to
      read man pages on this website (eg <a href="/man/ls">ls(1)</a>).
    </p>
  </section>

  <section class="home-contact">
    <h2 class="home-section-title">Projects</h2>
    <p>
      Other BSD-related software that might be interesting.
      These projects are actively maintained and I use them regularly. The
      <a href="https://github.com/4-4BSD/sourcezap#readme"
         rel="noopener"
         target="_blank">sourcezap</a>
      project
      maintains the FreeBSD source tree that this service uses under the hood.
    </p>
  </section>

  <div class="project-grid">
    <a class="project-card" href="https://github.com/4-4BSD/sourcezap#readme" target="_blank" rel="noopener">
      <h3 class="project-name">sourcezap</h3>
      <p class="project-tagline">sourcezap can help manage and install the BSD source tree</p>
      <p class="project-meta"><span class="lang-dot lang-shell"></span> shell<span class="project-license">0BSD</span></p>
    </a>
    <a class="project-card" href="https://github.com/4-4BSD/portzap#readme" target="_blank" rel="noopener">
      <h3 class="project-name">portzap</h3>
      <p class="project-tagline">portzap can help manage and install the BSD ports tree</p>
      <p class="project-meta"><span class="lang-dot lang-shell"></span> shell<span class="project-license">0BSD</span></p>
    </a>
    <a class="project-card" href="https://github.com/4-4BSD/4.4bsd.dev#readme" target="_blank" rel="noopener">
      <h3 class="project-name">4.4bsd.dev</h3>
      <p class="project-tagline">The source code for this website</p>
      <p class="project-meta"><span class="lang-dot lang-ruby"></span> ruby<span class="project-license">0BSD</span></p>
    </a>
  </div>
</main>
